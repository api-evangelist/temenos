{
  "opencollection": "1.0.0",
  "info": {
    "name": "Temenos Buy Now Pay Later Accounts Payment Configuration API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payment Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Payment Routing Configurations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/configuration/paymentRoutes"
          },
          "docs": "Retrieve payment routing configurations including clearing channel assignments and payment type routing rules."
        }
      ]
    }
  ],
  "bundled": true
}