{
  "opencollection": "1.0.0",
  "info": {
    "name": "Temenos Buy Now Pay Later Accounts Payments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.temenos.com/bnpl/v1/payments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiate a payment through country-specific clearing channels with local regulatory validation and compliance checks."
        },
        {
          "info": {
            "name": "Get Payment Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/payments/:paymentId",
            "params": [
              {
                "name": "paymentId",
                "value": "",
                "type": "path",
                "description": "Unique payment identifier"
              }
            ]
          },
          "docs": "Retrieve the current status and details of a previously initiated payment including processing status, timestamps, and confirmation details."
        }
      ]
    }
  ],
  "bundled": true
}