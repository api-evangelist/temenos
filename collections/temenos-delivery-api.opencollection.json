{
  "opencollection": "1.0.0",
  "info": {
    "name": "Temenos Buy Now Pay Later Accounts Delivery API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Delivery",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Submissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/delivery/submissions",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Records per page"
              },
              {
                "name": "page_start",
                "value": "",
                "type": "query",
                "description": "Starting record"
              }
            ]
          },
          "docs": "Retrieve a list of form submissions pending delivery processing."
        },
        {
          "info": {
            "name": "Get Submission Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/delivery/submissions/:submissionId",
            "params": [
              {
                "name": "submissionId",
                "value": "",
                "type": "path",
                "description": "Submission identifier"
              }
            ]
          },
          "docs": "Retrieve detailed submission data including form field values and submission metadata."
        },
        {
          "info": {
            "name": "Complete Delivery",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.temenos.com/bnpl/v1/delivery/submissions/:submissionId/complete",
            "params": [
              {
                "name": "submissionId",
                "value": "",
                "type": "path",
                "description": "Submission identifier"
              }
            ]
          },
          "docs": "Mark a submission delivery as completed after successful processing by the receiving system."
        }
      ]
    }
  ],
  "bundled": true
}