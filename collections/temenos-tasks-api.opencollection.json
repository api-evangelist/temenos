{
  "opencollection": "1.0.0",
  "info": {
    "name": "Temenos Buy Now Pay Later Accounts Tasks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/tasks",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Records per page"
              },
              {
                "name": "page_start",
                "value": "",
                "type": "query",
                "description": "Starting record"
              },
              {
                "name": "assignee",
                "value": "",
                "type": "query",
                "description": "Filter by assigned user"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by task status"
              }
            ]
          },
          "docs": "Retrieve tasks within journey workflows including assignment and completion status."
        }
      ]
    }
  ],
  "bundled": true
}