{
  "opencollection": "1.0.0",
  "info": {
    "name": "Temenos Buy Now Pay Later Accounts Event Store API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Event Store",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/events",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Records per page"
              },
              {
                "name": "page_start",
                "value": "",
                "type": "query",
                "description": "Starting record"
              },
              {
                "name": "eventType",
                "value": "",
                "type": "query",
                "description": "Filter by event type"
              },
              {
                "name": "source",
                "value": "",
                "type": "query",
                "description": "Filter by event source"
              },
              {
                "name": "dateFrom",
                "value": "",
                "type": "query",
                "description": "Start date filter"
              },
              {
                "name": "dateTo",
                "value": "",
                "type": "query",
                "description": "End date filter"
              }
            ]
          },
          "docs": "Retrieve business and system events from the event store raised by Temenos Transact and Infinity products. Supports filtering by event type, date range, and source."
        },
        {
          "info": {
            "name": "Get Event Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path",
                "description": "Event identifier"
              }
            ]
          },
          "docs": "Retrieve detailed information for a specific event including the full event payload and processing metadata."
        }
      ]
    }
  ],
  "bundled": true
}