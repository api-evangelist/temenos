{
  "opencollection": "1.0.0",
  "info": {
    "name": "Temenos Buy Now Pay Later Accounts Transaction Monitoring API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transaction Monitoring",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Transaction Monitoring Alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/monitoring/alerts",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of records to return per page"
              },
              {
                "name": "page_start",
                "value": "",
                "type": "query",
                "description": "Starting record number"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by alert status"
              },
              {
                "name": "ruleId",
                "value": "",
                "type": "query",
                "description": "Filter by monitoring rule identifier"
              }
            ]
          },
          "docs": "Retrieve alerts generated by AML transaction monitoring rules including suspicious activity patterns and threshold breaches."
        }
      ]
    }
  ],
  "bundled": true
}