{
  "opencollection": "1.0.0",
  "info": {
    "name": "Temenos Buy Now Pay Later Accounts Inventory API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Inventory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Securities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/inventory/securities",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of records per page"
              },
              {
                "name": "page_start",
                "value": "",
                "type": "query",
                "description": "Starting record number"
              },
              {
                "name": "assetClass",
                "value": "",
                "type": "query",
                "description": "Filter by asset class"
              },
              {
                "name": "exchange",
                "value": "",
                "type": "query",
                "description": "Filter by exchange"
              }
            ]
          },
          "docs": "Retrieve the securities master data inventory including equities, bonds, derivatives, and funds with their classification details and market identifiers."
        }
      ]
    }
  ],
  "bundled": true
}