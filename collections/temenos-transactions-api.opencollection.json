{
  "opencollection": "1.0.0",
  "info": {
    "name": "Temenos Buy Now Pay Later Accounts Transactions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Account Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/accounts/:accountId/transactions",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Unique account identifier"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of records to return per page"
              },
              {
                "name": "pageStart",
                "value": "",
                "type": "query",
                "description": "Pagination offset token or page number"
              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query",
                "description": "Start date for transaction history (ISO 8601 format)"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query",
                "description": "End date for transaction history (ISO 8601 format)"
              },
              {
                "name": "transactionType",
                "value": "",
                "type": "query",
                "description": "Filter by transaction type"
              }
            ]
          },
          "docs": "Retrieve transaction history for a specific account. Supports filtering by date range, amount, transaction type, and text search across narratives."
        },
        {
          "info": {
            "name": "List Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.temenos.com/bnpl/v1/transactions",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Records per page"
              },
              {
                "name": "page_start",
                "value": "",
                "type": "query",
                "description": "Starting record"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by transaction status"
              }
            ]
          },
          "docs": "Retrieve customer journey transactions including their current status, form data, and workflow position."
        }
      ]
    }
  ],
  "bundled": true
}